{
    "info": {
        "name": "siakad-mini",
        "description": "Postman collection for SIAKAD Mini API (UTS PBE). Covers all 10 endpoints, roles (admin & mahasiswa), and standard status codes (200, 201, 204, 401, 403, 404, 409, 422).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    ""
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "if (pm.response.code !== 204) {",
                    "    pm.test(\"Content-Type is JSON\", function () {",
                    "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                    "    });",
                    "    pm.test(\"Uniform response envelope (success + message)\", function () {",
                    "        const b = pm.response.json();",
                    "        pm.expect(b).to.have.property(\"success\");",
                    "        pm.expect(b).to.have.property(\"message\");",
                    "    });",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "01 Auth",
            "item": [
                {
                    "name": "01 Login Admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Access token returned\", function () {",
                                    "    pm.expect(res.data.access_token).to.be.a(\"string\");",
                                    "    pm.expect(res.data.user.role).to.eql(\"admin\");",
                                    "});",
                                    "pm.environment.set(\"admin_token\", res.data.access_token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"password\": \"{{admin_password}}\"\n}"
                        },
                        "url": "{{base_url}}/auth/login"
                    }
                },
                {
                    "name": "02 Login Mahasiswa",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Role is mahasiswa\", function () {",
                                    "    pm.expect(res.data.access_token).to.be.a(\"string\");",
                                    "    pm.expect(res.data.user.role).to.eql(\"mahasiswa\");",
                                    "});",
                                    "pm.environment.set(\"mhs_token\", res.data.access_token);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{mhs01_email}}\",\n    \"password\": \"{{mhs01_password}}\"\n}"
                        },
                        "url": "{{base_url}}/auth/login"
                    }
                },
                {
                    "name": "03 Get Me (Admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Profile role is admin\", function () {",
                                    "    pm.expect(res.data.role).to.eql(\"admin\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/auth/me"
                    }
                },
                {
                    "name": "04 Get Me (Mahasiswa)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Mahasiswa profile contains student info\", function () {",
                                    "    pm.expect(res.data.role).to.eql(\"mahasiswa\");",
                                    "    pm.expect(res.data.student).to.have.property(\"nim\");",
