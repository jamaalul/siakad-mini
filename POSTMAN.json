                {
                    "name": "02 Create Student (Admin)",
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const rand = Math.floor(100000 + Math.random() * 900000);",
                                    "pm.variables.set(\"new_nim\", \"199999\" + rand);",
                                    "pm.variables.set(\"new_email\", \"student\" + rand + \"@siakad.test\");"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Student created\", function () {",
                                    "    pm.expect(res.data).to.have.property(\"id\");",
                                    "    pm.expect(res.data.nim).to.eql(pm.variables.get(\"new_nim\"));",
                                    "});",
                                    "pm.environment.set(\"created_student_id\", res.data.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"nim\": \"{{new_nim}}\",\n    \"nama\": \"Test Student Automation\",\n    \"email\": \"{{new_email}}\",\n    \"prodi\": \"Teknik Informatika\",\n    \"angkatan\": 2024,\n    \"ipk_terakhir\": 3.65\n}"
                        },
                        "url": "{{base_url}}/students"
                    }
                },
                {
                    "name": "03 Get Student Detail",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Contains detail, enrollments, and SKS limits\", function () {",
                                    "    pm.expect(res.data).to.have.property(\"id\");",
                                    "    pm.expect(res.data).to.have.property(\"enrollments\");",
                                    "    pm.expect(res.data).to.have.property(\"total_sks\");",
                                    "    pm.expect(res.data).to.have.property(\"batas_sks\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/students/{{created_student_id}}"
                    }
                },
