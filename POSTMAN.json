        {
            "name": "03 Courses",
            "item": [
                {
                    "name": "01 List Courses",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"Course items have real-time quota calculations\", function () {",
                                    "    pm.expect(res.data).to.be.an(\"array\").that.is.not.empty;",
                                    "    const c = res.data[0];",
                                    "    pm.expect(c).to.have.property(\"id\");",
                                    "    pm.expect(c).to.have.property(\"kode_mk\");",
                                    "    pm.expect(c).to.have.property(\"terisi\");",
                                    "    pm.expect(c).to.have.property(\"sisa_kuota\");",
                                    "});",
                                    "pm.environment.set(\"course_id\", res.data[0].id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": "{{base_url}}/courses"
                    }
                },
                {
                    "name": "02 List Available Courses",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const res = pm.response.json();",
                                    "pm.test(\"All returned courses have available seats\", function () {",
                                    "    res.data.forEach(c => {",
                                    "        pm.expect(c.sisa_kuota).to.be.above(0);",
                                    "    });",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{mhs_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/courses?available=true&semester=1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "courses"
                            ],
                            "query": [
                                {
                                    "key": "available",
                                    "value": "true"
                                },
                                {
                                    "key": "semester",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                }
